local function fmtMoney(n)
    n = tonumber(n) or 0
    if n>=1e12 then return string.format("%.0fT", n/1e12) end
    if n>=1e9  then return string.format("%.0fB", n/1e9)  end
    if n>=1e6  then return string.format("%.0fM", n/1e6)  end
    if n>=1e3  then return string.format("%.0fK", n/1e3)  end
    return tostring(math.floor(n))
end


----------------------------------------------------------------
-- DATA LAYER
--   Config / GameData / Remotes: require the game's shared modules
--     (these are the SAME objects for every VM, so they work).
--   LIVE PLAYER DATA: Xeno runs in a separate Luau VM, so getgc and
--     require(MWClient.State) canNOT see the game's live State.data.
--     BUT the server pushes the full data table to the client over the
--     "Sync" RemoteEvent. We connect our OWN listener and cache it.
--     This is tab-independent and needs no memory reading.
----------------------------------------------------------------
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config, GameData, RemotesFolder
local function ensureModules()
    if Config and GameData and RemotesFolder then return true end
    local MW = ReplicatedStorage:FindFirstChild("MW") or ReplicatedStorage:WaitForChild("MW", 5)
    if MW then
        RemotesFolder = RemotesFolder or MW:FindFirstChild("Remotes")
        if not Config then
            local m=MW:FindFirstChild("Config");   if m then local ok,r=pcall(require,m); if ok then Config=r end end
        end
        if not GameData then
            local m=MW:FindFirstChild("GameData"); if m then local ok,r=pcall(require,m); if ok then GameData=r end end
        end
    end
    return (Config~=nil) and (GameData~=nil) and (RemotesFolder~=nil)
end

-- get a remote by name (defined early so the Sync listener can use it)
local function getRemote(name)
    ensureModules()
    if RemotesFolder then local r=RemotesFolder:FindFirstChild(name); if r then return r end end
    local MW = ReplicatedStorage:FindFirstChild("MW")
    if MW then local rf=MW:FindFirstChild("Remotes"); if rf then local r=rf:FindFirstChild(name); if r then return r end end end
    for _, v in ipairs(game:GetDescendants()) do
        if v.Name==name and (v:IsA("RemoteFunction") or v:IsA("RemoteEvent")) then return v end
    end
    return nil
end

-- LIVE DATA cache, fed by the server's Sync RemoteEvent
local LIVE = nil            -- last full data table the server sent
local LIVE_AT = 0           -- os.clock() when we received it
local syncHooked = false
local function hookSync()
    if syncHooked then return end
    -- Full snapshot pushes
    local sync = getRemote("Sync")
    if sync and sync:IsA("RemoteEvent") then
        sync.OnClientEvent:Connect(function(payload)
            if type(payload)=="table" then LIVE = payload; LIVE_AT = os.clock() end
        end)
        syncHooked = true
    end
    -- Incremental crew updates while auto-rolling (name/rarity/rolling per slot)
    local art = getRemote("AutoRollTick")
    if art and art:IsA("RemoteEvent") then
        art.OnClientEvent:Connect(function(cash, updates)
            if type(LIVE)~="table" then return end
            if type(cash)=="number" then LIVE.cash = cash end
            if type(updates)=="table" and type(LIVE.crew)=="table" then
                for k, v in pairs(updates) do
                    local idx = tonumber(k)
                    local slot = idx and LIVE.crew[idx]
                    if slot and type(v)=="table" then
                        slot.name = v.name; slot.rarity = v.rarity
                        slot.atk = v.atk; slot.def = v.def; slot.rolling = true
                    end
                end
                LIVE_AT = os.clock()
            end
        end)
    end
    -- Income / pools ticks keep cash & energy fresh for bank/jobs
    local inc = getRemote("IncomeTick")
    if inc and inc:IsA("RemoteEvent") then
        inc.OnClientEvent:Connect(function(delta)
            if type(LIVE)=="table" and type(delta)=="number" and type(LIVE.cash)=="number" then
                LIVE.cash = LIVE.cash + delta; LIVE_AT = os.clock()
            end
        end)
    end
    local pools = getRemote("PoolsTick")
    if pools and pools:IsA("RemoteEvent") then
        pools.OnClientEvent:Connect(function(energy, stamina, health)
            if type(LIVE)=="table" and type(LIVE.pools)=="table" then
                if type(energy)=="number" then LIVE.pools.energy = energy end
                if type(stamina)=="number" then LIVE.pools.stamina = stamina end
                if type(health)=="number" then LIVE.pools.health = health end
                LIVE_AT = os.clock()
            end
        end)
    end
end
-- Also try to pull an immediate snapshot so we don't wait for the next tick.
-- Several actions return the fresh data table; a harmless one is a no-op query
-- if the game exposes it, otherwise we just wait for the first Sync push.
local function primeData()
    hookSync()
    -- some builds echo current data on any ContractAction/no-op; skip unsafe calls.
end

local function getData()
    hookSync()
    return (type(LIVE)=="table") and LIVE or nil
end
local function sinceSync()
    if LIVE_AT==0 then return 0 end
    return os.clock()-LIVE_AT
end

-- rarity helpers
local function rarityNames()
    ensureModules()
    if GameData then local ok,n=pcall(function() return GameData.RARITY_NAMES end); if ok then return n end end
    return nil
end
local RARITY_FALLBACK = {"COMMON","UNCOMMON","RARE","EPIC","LEGENDARY","MYTHIC","SECRET","FORBIDDEN"}
-- Highest numeric key in a (possibly sparse) crew table. #crew is WRONG when a
-- slot in the middle is empty (crew[k]=nil after moving/reorganizing crew): Lua's
-- # operator stops at the first hole and would skip every slot past it. Always
-- use this to bound crew loops so empty/moved slots are still visited.
local function crewMaxKey(t)
    local n=0
    if type(t)=="table" then
        for k in pairs(t) do if type(k)=="number" and k>n then n=k end end
    end
    return n
end
local function rarityList()
    local n = rarityNames()
    if not n then return RARITY_FALLBACK end
    local t = {}; for i=1,#n do t[i]=string.upper(n[i] or ("R"..i)) end; return t
end
local function nameToIndex(name)
    local n=rarityNames(); name=string.upper(name)
    if n then for i=1,#n do if string.upper(n[i] or "")==name then return i end end end
    for i,v in ipairs(RARITY_FALLBACK) do if v==name then return i end end
    return nil
end
local function indexToName(i) local l=rarityList(); return (i and l[i]) or ("R"..tostring(i)) end
local function hasNativeAutoRoll() local d=getData(); return d~=nil and (d.derived or {}).autoRoll==true end
local function hireTierIds()
    ensureModules()
    if Config then
        local ok,tiers=pcall(function() return Config.CREW.hireTiers end)
        if ok and type(tiers)=="table" then
            local ids={}; for _,t in ipairs(tiers) do if t.id then table.insert(ids,t.id) end end
            if #ids>0 then return ids end
        end
    end
    return {"street","organized","syndicate"}
end
local function configCount(pathA, fallback)
    ensureModules()
    if Config then
        local ok,v=pcall(function() return #Config.CONTRACTS[pathA] end)
        if ok and v and v>0 then return v end
    end
    return fallback
end
-- expose for modules that read GameData/Config directly
local function getGameData() ensureModules(); return GameData end
local function getConfig()   ensureModules(); return Config end

