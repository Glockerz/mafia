----------------------------------------------------------------
-- OPS  (collect READY ops, then start the best affordable ones)
----------------------------------------------------------------
local function opSlotCount(data)
    local cfg=getConfig()
    local count=1
    if cfg then
        local ok,S=pcall(function() return cfg.OPERATION_SLOTS end)
        if ok and type(S)=="table" then
            if (data.level or 1) >= (S.level15 or math.huge) then count=count+1 end
            if (data.level or 1) >= (S.level30 or math.huge) then count=count+1 end
        end
    end
    if (data.derived or {}).fourthSlot then count=count+1 end
    return count
end

-- score an operation for "best" selection
-- read a numeric field trying several possible key names (op data field
-- names aren't guaranteed, so we look at all the likely ones)
local function numField(op, ...)
    for _,k in ipairs({...}) do
        local v=op[k]
        if type(v)=="number" then return v end
    end
    return nil
end
local function opCash(op)  return numField(op,"cash","reward","payout","money","income","pay","profit") or 0 end
local function opXp(op)    return numField(op,"xp","exp","experience") or 0 end
local function opDur(op)   return math.max(1, numField(op,"duration","time","seconds","dur","length") or 1) end
local function opCost(op)  return numField(op,"cost","price","energy","stake") or 0 end
local function opCrate(op) return numField(op,"crateChance","crate","cratePct","dropChance") or 0 end

local function opScore(op)
    local dur=opDur(op)
    local cash=opCash(op)
    local xp=opXp(op)
    local crate=opCrate(op)
    local s=OPT.opsStrategy
    if s=="cash"    then return cash end
    if s=="xp"      then return xp end
    if s=="xp/sec"  then return xp/dur end
    if s=="fastest" then return -dur end          -- shortest duration wins
    if s=="crate"   then return crate*1e9 + cash/dur end -- prefer crate, tiebreak by cash/sec
    return cash/dur                                 -- default cash/sec
end

local function opsPass(data)
    local gd=getGameData(); if not gd then return end
    local ok,OPS=pcall(function() return gd.OPERATIONS end)
    if not ok or type(OPS)~="table" then return end

    local active=(data.operations or {}).active or {}
    local slots=opSlotCount(data)
    local Collect=getRemote("CollectOperation")
    local Start=getRemote("StartOperation")

    -- 1) collect any READY ops (remaining <= 0)
    for i=1,slots do
        if _G.CrewAutoRoll_Stop then break end
        local a=active[i]
        if a and (a.remaining or 0)<=0 and a.opId then
            if throttled(Collect,i) then stats.opsCollected=stats.opsCollected+1; updatePanel("collected op slot "..i) end
        end
    end

    -- refresh after collecting (freed slots / new cash)
    data=getData() or data
    active=(data.operations or {}).active or {}
    local used=0
    for i=1,slots do if active[i] and active[i].opId then used=used+1 end end
    local free=slots-used
    if free<=0 then return end

    -- 2) rank UNLOCKED ops within max-cost, best first (ignoring current cash)
    local cash=data.cash or 0
    local level=data.level or 1
    local respect=data.respect or 0
    local candidates={}
    for _,op in ipairs(OPS) do
        local locked=false
        if op.level and level<op.level then locked=true end
        if op.respect and respect<op.respect then locked=true end
        if not locked and opCost(op)<=OPT.opsMaxCost then
            table.insert(candidates,op)
        end
    end
    if #candidates==0 then return end
    table.sort(candidates,function(a,b) return opScore(a)>opScore(b) end)

    -- 3) SAVE-UP: the top-ranked op is the target. If we can't afford it yet,
    --    do NOT spend cash on cheaper ops - wait and let cash build up.
    --    (This is what "pick best by cash" needs: save for the biggest payout.)
    local target=candidates[1]
    local tcost=opCost(target)
    if tcost>cash then
        updatePanel(("saving for op: %s pays %s (need %s, have %s)")
            :format(target.name or target.id, fmtMoney(opCash(target)), fmtMoney(tcost), fmtMoney(cash)))
        return
    end

    -- 4) Fill EVERY free slot with the best op we can currently afford.
    --    candidates is sorted best-first, so each slot re-scans from the top;
    --    this means the SAME best op is started repeatedly across slots as long
    --    as it stays affordable, and only drops to a lesser op when the best one
    --    can no longer be paid for.
    while free>0 and not _G.CrewAutoRoll_Stop do
        local pick=nil
        for _,op in ipairs(candidates) do
            if opCost(op)<=cash then pick=op; break end
        end
        if not pick then break end                 -- can't afford anything more
        local ok2=throttled(Start,pick.id)
        if ok2==false then break end               -- rate limited; try next pass
        stats.opsStarted=stats.opsStarted+1
        cash=cash-opCost(pick)
        free=free-1
        updatePanel("started op: "..(pick.name or pick.id).." (pays "..fmtMoney(opCash(pick))..")")
    end
end

