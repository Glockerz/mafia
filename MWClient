-- REMOTE ACTIONS + throttle
----------------------------------------------------------------
local function invoke(remote,...)
    if not remote then return true end
    local args={...}
    local ok,res=pcall(function() return remote:InvokeServer(table.unpack(args)) end)
    if not ok then return false end
    if type(res)=="table" then
        if res.ok then return true,res end
        local msg=tostring(res.msg or ""):lower()
        if msg:find("rate") or msg:find("slow") or msg:find("wait")
        or msg:find("too fast") or msg:find("limit") then return false,"limited" end
        return true,res
    end
    return true
end
local backoff=BACKOFF_START
local function throttled(remote,...)
    local ok,why=invoke(remote,...)
    if ok==false and why=="limited" then
        stats.limited=true
        updatePanel("rate limited - waiting "..string.format("%.1f",backoff).."s")
        task.wait(backoff)
        backoff=math.min(backoff*BACKOFF_GROWTH,BACKOFF_MAX)
        return false
    end
    stats.limited=false; backoff=BACKOFF_START
    task.wait(OPT.callGap)
    return true,why
end

