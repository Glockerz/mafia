-- parse a typed money string: accepts 1000000, 1,000,000, 1m, 2.5k, 3b, 1t, $5M
local function parseMoney(s)
    s=tostring(s):lower():gsub("[%s,%$]","")
    if s=="" then return nil end
    local num,suf=s:match("^([%d%.]+)([kmbt]?)$")
    if not num then return nil end
    local n=tonumber(num); if not n then return nil end
    local mult=({k=1e3,m=1e6,b=1e9,t=1e12})[suf] or 1
    return math.floor(n*mult)
end

-- a row with a typeable TextBox that stores/reads a number via get/set
local function inputRow(text, get, set, hint)
    local r=rowFrame(30)
    mklabel(r,text, UDim2.new(0,10,0,0), UDim2.new(1,-150,1,0),13,TXT,false,nil,6)
    local box=Instance.new("TextBox")
    box.AnchorPoint=Vector2.new(1,0.5); box.Position=UDim2.new(1,-6,0.5,0)
    box.Size=UDim2.fromOffset(128,24); box.BackgroundColor3=Color3.fromRGB(40,44,60)
    box.BorderSizePixel=0; box.Font=Enum.Font.GothamBold; box.TextSize=13
    box.TextColor3=ACCENT; box.ClearTextOnFocus=false
    box.PlaceholderText=hint or ""; box.PlaceholderColor3=Color3.fromRGB(120,126,140)
    box.Text=tostring(get()); box.ZIndex=6; box.Parent=r
    Instance.new("UICorner",box).CornerRadius=UDim.new(0,6)
    local pad=Instance.new("UIPadding",box); pad.PaddingLeft=UDim.new(0,8); pad.PaddingRight=UDim.new(0,8)
    box.FocusLost:Connect(function()
        local n=parseMoney(box.Text)
        if n then set(n) end
        box.Text="$"..fmtMoney(get())      -- normalize display (e.g. "$1M")
    end)
    box.Focused:Connect(function()
        box.Text=tostring(math.floor(get())) -- show raw number for easy editing
    end)
    box.Text="$"..fmtMoney(get())
    table.insert(guiRefreshers, function() box.Text="$"..fmtMoney(get()) end)
    return r
end

