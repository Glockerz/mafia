-- JOBS
----------------------------------------------------------------
local function jobEnergyCost(job,data)
    local jd=(data.jobs or {})[job.id]; local mt=jd and jd.masteryTier or 0
    return math.max(1,math.floor(job.energy*(1-(mt>=2 and 0.05 or 0))+0.5))
end
local function jobsPassLive(data)
    local gd=getGameData(); if not gd then return end
    local ok,JOBS=pcall(function() return gd.JOBS end)
    if not ok or type(JOBS)~="table" then return end
    local DoJob=getRemote("DoJob")
    local energy=(data.pools and data.pools.energy) or 0
    local level=data.level or 1; local guard=0

    -- In "highest" mode we commit to the single most expensive UNLOCKED job
    -- and wait until we can afford it, rather than spending on cheaper jobs.
    -- Recompute the target each iteration (mastery can change costs).
    local function pickTarget()
        local best,bestCost
        for _,job in ipairs(JOBS) do
            if level>=job.level then
                local cost=jobEnergyCost(job,data)
                if not best then best,bestCost=job,cost
                elseif OPT.jobsStrategy=="highest" and cost>bestCost then best,bestCost=job,cost
                elseif OPT.jobsStrategy=="lowest"  and cost<bestCost then best,bestCost=job,cost end
            end
        end
        return best,bestCost
    end

    while not _G.CrewAutoRoll_Stop and guard<200 do
        guard=guard+1
        local target,cost=pickTarget()
        if not target then break end                          -- no unlocked jobs

        if cost > (energy-OPT.jobsReserve) then
            -- Can't afford the TARGET job right now.
            -- highest mode: SAVE UP (wait), don't waste energy on cheaper jobs.
            -- lowest mode: target is already the cheapest, so nothing is affordable.
            updatePanel(("saving energy for: %s (need %d, have %d)")
                :format(target.name or target.id, cost, math.max(0,energy)))
            break
        end

        updatePanel(("doing job: %s (%d energy)"):format(target.name or target.id,cost))
        local ok2,why=throttled(DoJob,target.id)
        if ok2==false then break end                          -- rate limited
        if type(why)=="table" and why.ok then stats.jobs=stats.jobs+1
        else local d2=getData(); energy=(d2 and d2.pools and d2.pools.energy) or (energy-cost); break end
        energy=energy-cost
    end
end

