local CONFIG_FOLDER = "MafiaWarsAutoSuite_Configs"
local CONFIG_NAME   = "default"   -- change via the GUI text box
if makefolder and isfolder and not isfolder(CONFIG_FOLDER) then
    pcall(function() makefolder(CONFIG_FOLDER) end)
end

local function configPath() return CONFIG_FOLDER.."/"..(CONFIG_NAME or "default")..".json" end

-- refreshers set later by the GUI so a load repaints every control
local guiRefreshers = {}
local function runGuiRefreshers()
    for _, fn in ipairs(guiRefreshers) do pcall(fn) end
end

local function SaveConfiguration()
    if not writefile then log("config: writefile not supported by this executor"); return false end
    -- shallow copy OPT; terrPicked (numeric-keyed) becomes a string-keyed object in JSON
    local data = {}
    for k, v in pairs(OPT) do
        if type(v) == "table" then
            local t = {}
            for kk, vv in pairs(v) do t[tostring(kk)] = vv end
            data[k] = t
        else
            data[k] = v
        end
    end
    local ok, enc = pcall(function() return HttpService:JSONEncode(data) end)
    if not ok then log("config: encode failed", enc); return false end
    local wok = pcall(function() writefile(configPath(), enc) end)
    if wok then log("config saved -> "..configPath()) else log("config: write failed") end
    return wok
end

local function LoadConfiguration()
    if not (readfile and isfile) then log("config: readfile not supported"); return false end
    if not isfile(configPath()) then log("config: no file at "..configPath()); return false end
    local ok, decoded = pcall(function() return HttpService:JSONDecode(readfile(configPath())) end)
    if not (ok and type(decoded) == "table") then log("config: decode failed"); return false end
    for k, v in pairs(decoded) do
        if OPT[k] ~= nil then
            if k == "terrPicked" and type(v) == "table" then
                -- restore numeric crew-slot keys
                local t = {}
                for kk, vv in pairs(v) do t[tonumber(kk) or kk] = vv end
                OPT.terrPicked = t
            else
                OPT[k] = v
            end
        end
    end
    log("config loaded <- "..configPath())
    runGuiRefreshers()
    return true
end

