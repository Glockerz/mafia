-- pick the stamina track to feed: user's fixed choice, else the lowest-level one
local function famPickStaminaTrack(fam)
    local maxLvl = fam.maxPerkLevel or 20
    if OPT.famStaminaTarget~="auto" then
        local t=OPT.famStaminaTarget
        local lvl=(fam.perks and fam.perks[t]) or 0
        if lvl<maxLvl then return t end
        return nil
    end
    local best, bestLvl=nil, math.huge
    for _,t in ipairs(FAM_STAMINA) do
        local lvl=(fam.perks and fam.perks[t]) or 0
        if lvl<maxLvl and lvl<bestLvl then best,bestLvl=t,lvl end
    end
    return best
end

local function famPass()
    local fam=famFetchInfo()
    if not fam then updatePanel("family: no data (not in a family?)"); return end
    local maxLvl=fam.maxPerkLevel or 20
    local FA=getRemote("FamilyAction")

    -- 1) Feed your stamina into a stamina perk (any member can do this)
    if OPT.famStamina then
        local data=getData()
        local stamina=(data and data.pools and data.pools.stamina) or 0
        local track=famPickStaminaTrack(fam)
        if track and stamina > OPT.famStaminaKeep then
            -- give 5 if we can afford to keep reserve, else 1
            local give = (stamina - OPT.famStaminaKeep) >= 5 and 5 or 1
            if throttled(FA,"contribute",track,give) then
                stats.famPerks=stats.famPerks+1
                updatePanel("gave "..give.." stamina -> "..track)
            end
        end
    end

    -- 2) Buy CASH perks from the vault (needs Advisor+)
    if OPT.famCashPerks and famRankOK(fam.role) then
        for _,t in ipairs(FAM_CASH) do
            if _G.CrewAutoRoll_Stop then break end
            local lvl=(fam.perks and fam.perks[t]) or 0
            local cost=fam.perkCosts and fam.perkCosts[lvl+1]
            local levelReq=lvl+1
            if lvl<maxLvl and cost and (fam.level or 1)>=levelReq and cost<=(fam.vault or 0) then
                if throttled(FA,"buyperk",t) then
                    stats.famPerks=stats.famPerks+1
                    updatePanel("bought cash perk: "..t.." (lvl "..(lvl+1)..")")
                end
            end
        end
    end

    -- 3) Buy GOLD perks from the vault gold (needs Advisor+)
    if OPT.famGoldPerks and famRankOK(fam.role) then
        for _,t in ipairs(FAM_GOLD) do
            if _G.CrewAutoRoll_Stop then break end
            local lvl=(fam.perks and fam.perks[t]) or 0
            local cost=fam.goldPerkCosts and fam.goldPerkCosts[lvl+1]
            if lvl<maxLvl and cost and cost<=(fam.vaultGold or 0) then
                if throttled(FA,"buygoldperk",t) then
                    stats.famPerks=stats.famPerks+1
                    updatePanel("bought gold perk: "..t.." (lvl "..(lvl+1)..")")
                end
            end
        end
    end
end

----------------------------------------------------------------
-- BOSSES
--   GameData.BOSSES = ordered list { id, name, level, order, city,
--       hp, cash, crate, title, faction }
--   data.bosses[id] = { hp, kills, respawnAt } (server state)
--   BossAction:InvokeServer("attack", bossId) ->
--       { ok, myPower, bossRoll, won, dmg, hitBack, bossHp, bossMaxHp,
--         health, stamina, killed, rewards }
--   Unlock: my level >= boss.level AND previous boss (order-1) killed >=1x
--   Available: serverNow + sinceSync() >= respawnAt
----------------------------------------------------------------
local function bossList()
    local gd=getGameData(); if not gd then return nil end
    local ok,B=pcall(function() return gd.BOSSES end)
    if ok and type(B)=="table" then return B end
    return nil
end

-- is this boss unlocked for me right now (level + prior-boss requirement)?
local function bossUnlocked(data, BOSSES, boss)
    if (data.level or 1) < (boss.level or 1) then return false end
    if (boss.order or 1) > 1 then
        local prev=BOSSES[boss.order-1]
        local pr=prev and (data.bosses or {})[prev.id]
        if not pr or (pr.kills or 0) < 1 then return false end
    end
    return true
end

-- is this boss alive and attackable right now (not recovering)?
local function bossReady(data, boss)
    local rec=(data.bosses or {})[boss.id]
    if not rec then return true end                 -- never fought = full hp, ready
    local nowSrv=(data.serverNow or os.time())+sinceSync()
    if nowSrv < (rec.respawnAt or 0) then return false end  -- still recovering
    return true
end

-- choose the boss to fight based on strategy; returns the boss table or nil
local function bossPickTarget(data, BOSSES)
    local best,bestScore=nil,nil
    for _,boss in ipairs(BOSSES) do
        if bossUnlocked(data,BOSSES,boss) and bossReady(data,boss) then
            -- when "keep farming" is OFF, skip bosses we've already killed at
            -- least once (unless none are left un-killed, then fall through)
            local rec=(data.bosses or {})[boss.id]
            local alreadyKilled=(rec and (rec.kills or 0)>0) or false
            if OPT.bossRepeat or not alreadyKilled then
                local score
                if OPT.bossTarget=="weakest"  then score=-(boss.order or 0)  -- lowest order first
                elseif OPT.bossTarget=="richest" then score=(boss.cash or 0) -- most cash first
                else score=(boss.order or 0) end                             -- strongest: highest order
                if bestScore==nil or score>bestScore then best,bestScore=boss,score end
            end
        end
    end
    -- if "keep farming" is off and everything unlocked is already killed,
    -- fall back to farming anyway so we're not idle
    if not best and not OPT.bossRepeat then
        for _,boss in ipairs(BOSSES) do
            if bossUnlocked(data,BOSSES,boss) and bossReady(data,boss) then
                local score
                if OPT.bossTarget=="weakest"  then score=-(boss.order or 0)
                elseif OPT.bossTarget=="richest" then score=(boss.cash or 0)
                else score=(boss.order or 0) end
                if bestScore==nil or score>bestScore then best,bestScore=boss,score end
            end
        end
    end
    return best
end

local function bossPass()
    local data=getData(); if not data then return end
    local BOSSES=bossList(); if not BOSSES then return end
    local BA=getRemote("BossAction"); if not BA then return end

    -- safety gates: don't fight while low on health or below stamina reserve
    local health=(data.pools and data.pools.health) or 0
    local stamina=(data.pools and data.pools.stamina) or 0
    if health <= OPT.bossMinHealth then
        updatePanel(("bosses: health low (%d) - waiting to heal"):format(math.floor(health)))
        return
    end
    if stamina <= OPT.bossMinStamina then
        updatePanel("bosses: stamina reserve reached - waiting")
        return
    end

    local target=bossPickTarget(data,BOSSES)
    if not target then
        updatePanel("bosses: none ready (all recovering / locked)")
        return
    end

    -- land a hit; the server returns the fight result (RNG is server-side)
    local ok,res=pcall(function() return BA:InvokeServer("attack", target.id) end)
    if not ok or type(res)~="table" then task.wait(OPT.callGap); return end
    if not res.ok then
        local msg=tostring(res.msg or ""):lower()
        if msg:find("rate") or msg:find("slow") or msg:find("wait") or msg:find("limit") then
            stats.limited=true; task.wait(backoff)
            backoff=math.min(backoff*BACKOFF_GROWTH,BACKOFF_MAX)
        elseif res.msg then updatePanel("boss: "..tostring(res.msg)) end
        return
    end
    stats.limited=false; backoff=BACKOFF_START
    stats.bossHits=stats.bossHits+1
    if res.killed then
        stats.bossKills=stats.bossKills+1
        local cash=(res.rewards and res.rewards.cash) or 0
        updatePanel(("KILLED %s! +%s"):format(target.name or target.id, fmtMoney(cash)))
    else
        updatePanel(("hit %s  %s dmg  (boss %s/%s, my hp %s)"):format(
            target.name or target.id, tostring(res.dmg or 0),
            fmtMoney(res.bossHp or 0), fmtMoney(res.bossMaxHp or 0), tostring(res.health or "?")))
    end
    task.wait(OPT.callGap)
end

----------------------------------------------------------------
-- AUTO-ATTACK PLAYERS  (Fight tab / hit list)
--   GetHitList:InvokeServer(force) -> { ok, list[], warTargets[], cooldown, msg }
--     each target: { userId, name, level, respect, online, stamina, shielded }
--       * stamina  = stamina COST to attack this target (1 / 2 / 3 ...)
--       * shielded = seconds of shield left on THEM (skip if > 0)
--       * online   -> steal 5%, offline -> steal 10%
--   Attack:InvokeServer(userId) -> { ok, won, stolen, xp, respect, dmg,
--                                    knockout, retryIn, dmgTaken, msg, ... }
--   Server refreshes targets every ~10s and enforces a per-target cooldown.
----------------------------------------------------------------
local pvpCooldown = {}      -- userId -> os.clock() time we may hit them again
local pvpDailyHits = {}     -- userId -> attacks made against them since pvpDayStamp
local pvpDayStamp = os.date("%Y-%m-%d")  -- resets the per-target daily counters at day rollover
local pvpMaxed    = {}      -- userId -> true : server said daily cap reached (skip until reset)
local pvpHitCache = nil     -- cached hit list; refreshed on a timer
local pvpHitAt   = 0

-- reset the per-target daily counters when the calendar day changes
local function pvpRollDay()
    local today = os.date("%Y-%m-%d")
    if today ~= pvpDayStamp then
        pvpDayStamp = today
        pvpDailyHits = {}
        pvpMaxed = {}
    end
end

-- pull a fresh hit list from the server (rate-limited to ~ every 10s to match
-- the server's own refresh cadence)
local function pvpGetTargets(force)
    local GHL=getRemote("GetHitList"); if not GHL then return nil end
    local now=os.clock()
    if not force and pvpHitCache and (now-pvpHitAt)<10 then return pvpHitCache end
    local ok,res=pcall(function() return GHL:InvokeServer(false) end)
    if not ok or type(res)~="table" or not res.ok then return pvpHitCache end
    pvpHitCache=res; pvpHitAt=now
    return res
end

-- gather the eligible pool honoring stamina cost / shield / war-only / cooldown
local function pvpEligible(res)
    local pool={}
    local now=os.clock()
    local function consider(v, isWar)
        if not v or not v.userId then return end
        local cost=v.stamina or 1
        if OPT.atkStaminaMode=="exact" then
            if cost ~= OPT.atkMaxStamina then return end       -- must match exactly
        else
            if cost > OPT.atkMaxStamina then return end        -- costs too much stamina
        end
        if (pvpCooldown[v.userId] or 0) > now then return end  -- still on our cooldown
        if pvpMaxed[v.userId] then return end                  -- server already said daily cap hit
        if OPT.atkPerTargetDaily and OPT.atkPerTargetDaily > 0
           and (pvpDailyHits[v.userId] or 0) >= OPT.atkPerTargetDaily then
            return                                             -- we've hit our per-target daily limit
        end
        if OPT.atkSkipShielded and type(v.shielded)=="number" and v.shielded>0 then return end
        table.insert(pool, {t=v, war=isWar, cost=cost})
    end
    for _,v in ipairs(res.warTargets or {}) do consider(v,true) end
    if not OPT.atkWarOnly then
        for _,v in ipairs(res.list or {}) do consider(v,false) end
    end
    -- rank: war targets first; then cheapest stamina; then prefer offline
    -- (10% steal vs 5%) if asked; then highest respect
    table.sort(pool, function(a,b)
        if a.war~=b.war then return a.war end
        if a.cost~=b.cost then return a.cost<b.cost end
        if OPT.atkPreferOffline then
            local ao=a.t.online and 1 or 0; local bo=b.t.online and 1 or 0
            if ao~=bo then return ao<bo end
        end
        return (a.t.respect or 0) > (b.t.respect or 0)
    end)
    return pool
end

local function pvpPass()
    local data=getData(); if not data then return end
    local ATK=getRemote("Attack"); if not ATK then return end
    pvpRollDay()   -- clear per-target daily counters if the day changed

    -- optionally hold fire while our own defensive shield is up (attacking drops it)
    if OPT.atkKeepShield then
        local nowSrv=(data.serverNow or os.time())+sinceSync()
        if (data.shieldUntil or 0) > nowSrv then
            updatePanel("attack: my shield is active - holding")
            return
        end
    end

    -- ROTATION LOOP: keep attacking DIFFERENT eligible targets back-to-back.
    -- After each hit the target is put on its per-target cooldown (20-30s), so
    -- pvpEligible drops them and the next iteration naturally moves to someone
    -- else - i.e. we work through the hit list while earlier targets cool down,
    -- instead of idling for one target's cooldown. We stop only when we run out
    -- of eligible targets, hit a health/stamina limit, or get rate limited.
    local guard=0
    while not _G.CrewAutoRoll_Stop and guard<50 do
        guard=guard+1

        -- refresh MY pools each iteration (health/stamina change as we fight)
        data=getData() or data
        local health=(data.pools and data.pools.health) or 0
        local stamina=(data.pools and data.pools.stamina) or 0
        if health <= OPT.atkMinHealth then
            updatePanel(("attack: health low (%d) - waiting to heal"):format(math.floor(health)))
            return
        end
        if stamina <= OPT.atkMinStamina then
            updatePanel("attack: stamina reserve reached - waiting")
            return
        end

        local res=pvpGetTargets(false)
        if not res then updatePanel("attack: no hit list yet") return end
        local pool=pvpEligible(res)
        if #pool==0 then
            updatePanel((guard==1
                and "attack: no targets %s %d stamina"
                or  "attack: all targets on cooldown/maxed - waiting"):format(
                OPT.atkStaminaMode=="exact" and "at exactly" or "<=", OPT.atkMaxStamina))
            return
        end

        local pick=pool[1].t
        -- don't spend below the reserve on this specific hit
        if stamina - (pool[1].cost or 1) < OPT.atkMinStamina then
            updatePanel("attack: would dip below stamina reserve - waiting")
            return
        end

        local ok,rep=pcall(function() return ATK:InvokeServer(pick.userId) end)
        if not ok or type(rep)~="table" then task.wait(OPT.callGap); return end
        if not rep.ok then
            local msg=tostring(rep.msg or ""):lower()
            -- CASE 1: we've hit THIS player their daily max (usually 5). This is NOT
            -- a global rate limit - it is per-target and permanent until day reset.
            -- Mark the target maxed and rotate to someone else immediately (don't
            -- back off, don't re-pick this same person).
            if msg:find("daily") or msg:find("max") or msg:find("already")
            or msg:find("times") or msg:find("cap") or msg:find("no more") then
                pvpMaxed[pick.userId]=true
                updatePanel(("attack: %s maxed for today - next target"):format(
                    pick.name or ("#"..tostring(pick.userId))))
                -- loop continues; pvpEligible now skips them and picks another
            -- CASE 2: a genuine GLOBAL rate limit (server-wide "too fast"). Back off
            -- and end this pass (waiting is unavoidable here).
            elseif msg:find("rate") or msg:find("slow") or msg:find("too fast")
            or msg:find("wait a") or msg:find("try again") then
                stats.limited=true; task.wait(backoff)
                backoff=math.min(backoff*BACKOFF_GROWTH,BACKOFF_MAX)
                return
            else
                -- CASE 3: any other per-target rejection (their shield, cooldown, in
                -- hospital, offline-only, etc). Put a cooldown on JUST this target so
                -- we rotate off them instead of hammering the same person forever.
                local retry=tonumber(rep.retryIn)
                pvpCooldown[pick.userId]=os.clock()+(retry or 60)
                if rep.msg then updatePanel("attack: "..tostring(rep.msg).." - next target") end
                -- loop continues to the next eligible target
            end
        else
            stats.limited=false; backoff=BACKOFF_START

            -- count this successful hit against the target's per-day tally; when it
            -- reaches the cap, pvpEligible will skip them from now on
            pvpDailyHits[pick.userId]=(pvpDailyHits[pick.userId] or 0)+1
            if OPT.atkPerTargetDaily and OPT.atkPerTargetDaily > 0
               and pvpDailyHits[pick.userId] >= OPT.atkPerTargetDaily then
                pvpMaxed[pick.userId]=true
            end

            -- apply the game's per-target cooldown so this pass (and the next)
            -- rotate to OTHER targets while this one cools down
            local cfg=getConfig()
            local cd=(cfg and cfg.COMBAT and cfg.COMBAT.targetCooldown) or 30
            pvpCooldown[pick.userId]=os.clock()+cd

            stats.pvpAttacks=stats.pvpAttacks+1
            if rep.won then
                stats.pvpWins=stats.pvpWins+1
                stats.pvpStolen=stats.pvpStolen+(rep.stolen or 0)
                updatePanel(("BEAT %s  +%s  (%d stamina)%s"):format(
                    pick.name or ("#"..tostring(pick.userId)), fmtMoney(rep.stolen or 0),
                    pool[1].cost or 1, rep.knockout and " KO!" or ""))
            else
                updatePanel(("lost to %s  (-%s hp)"):format(
                    pick.name or ("#"..tostring(pick.userId)), tostring(rep.dmgTaken or 0)))
            end
        end

        -- pace between hits, then loop to the NEXT different target
        task.wait(OPT.callGap)
    end
end

----------------------------------------------------------------
-- TERRITORY  (its OWN fast loop - speed matters, rivals compete)
--   TerritoryAction("map")     -> { ok, districts[], orders }
--   TerritoryAction("claim",id)-> grab an UNCLAIMED district
--   TerritoryAction("attack",id)-> siege a rival district
--   A district: { id, name, holderId, mine, hp, hpMax, claimCost,
--                 tier, underSiege, shieldUntil, serverNow }
----------------------------------------------------------------
local terrRunning = false
local terrInflight = {}   -- id -> true while a claim/attack is pending (avoid double-fire)

----------------------------------------------------------------
-- Territory action QUEUE
--   The server has no batch API (station/claim/attack each take one
--   target per InvokeServer call), and firing them all at once instantly
--   rate-limits us. So instead of many concurrent task.spawns, we push
--   jobs onto ONE queue that a single worker drains with pacing + backoff.
--   Claims are urgent (land grab) so they go to the FRONT; attacks and
--   troop stationing go to the back.
----------------------------------------------------------------
local terrQueue = {}          -- list of { action=..., a=.., b=.., prio=bool, done=fn }
local terrWorkerOn = false
local terrBackoff = BACKOFF_START

local function terrEnqueue(job, urgent)
    if urgent then table.insert(terrQueue, 1, job) else terrQueue[#terrQueue+1] = job end
end

local function terrWorker()
    if terrWorkerOn then return end
    terrWorkerOn = true
    task.spawn(function()
        while not _G.CrewAutoRoll_Stop and #terrQueue > 0 do
            local job = table.remove(terrQueue, 1)
            local TA = getRemote("TerritoryAction")
            local ok, res = pcall(function()
                if job.b ~= nil then return TA:InvokeServer(job.action, job.a, job.b)
                elseif job.a ~= nil then return TA:InvokeServer(job.action, job.a)
                else return TA:InvokeServer(job.action) end
            end)
            local success = ok and type(res)=="table" and res.ok
            -- detect rate-limit and back off, requeuing the job at the front
            local limited = false
            if ok and type(res)=="table" and not res.ok then
                local msg = tostring(res.msg or ""):lower()
                if msg:find("rate") or msg:find("slow") or msg:find("wait")
                or msg:find("too fast") or msg:find("limit") then limited = true end
            end
            if limited then
                stats.limited = true
                table.insert(terrQueue, 1, job)      -- retry this one first
                updatePanel("territory rate limited - waiting "..string.format("%.1f",terrBackoff).."s")
                task.wait(terrBackoff)
                terrBackoff = math.min(terrBackoff*BACKOFF_GROWTH, BACKOFF_MAX)
            else
                stats.limited = false
                terrBackoff = BACKOFF_START
                if job.done then pcall(job.done, success, res) end
                task.wait(math.max(0.05, OPT.terrActionGap))
            end
        end
        -- if we stopped (not just drained), discard any leftover jobs so a
        -- later restart doesn't replay stale claims/attacks/stationings
        if _G.CrewAutoRoll_Stop then terrQueue = {} end
        terrWorkerOn = false
    end)
end

local function terrFetchMap()
    local TA = getRemote("TerritoryAction")
    if not TA then return nil end
    local ok, res = pcall(function() return TA:InvokeServer("map") end)
    if ok and type(res)=="table" and res.ok and type(res.districts)=="table" then
        return res.districts
    end
    return nil
end

-- score rival attack targets; higher = attack first
local function terrAttackScore(d)
    if OPT.terrTarget=="highest tier" then return (d.tier or 0) end
    -- default "weakest": lowest current hp first (fastest to flip)
    return -(d.hp or math.huge)
end
-- score claim targets
local function terrClaimScore(d)
    if OPT.terrTarget=="cheapest claim" then return -(d.claimCost or math.huge) end
    if OPT.terrTarget=="highest tier"  then return (d.tier or 0) end
    return (d.tier or 0) -- weakest doesn't apply to empty; prefer higher tier
end

local function terrFireClaim(id)
    if terrInflight[id] then return end
    terrInflight[id]=true
    terrEnqueue({ action="claim", a=id, done=function(success,res)
        if success then
            stats.terrClaims=stats.terrClaims+1
            updatePanel("CLAIMED district "..tostring(id))
        end
        terrInflight[id]=nil
    end }, true)   -- claims are URGENT: jump to front of the queue
    terrWorker()
end
local function terrFireAttack(id)
    if terrInflight[id] then return end
    terrInflight[id]=true
    terrEnqueue({ action="attack", a=id, done=function(success,res)
        if success then
            stats.terrAttacks=stats.terrAttacks+1
            if res and res.captured and res.capturedByMe then updatePanel("CAPTURED "..tostring(res.districtName or id))
            else updatePanel("attacked "..tostring(id)) end
        end
        terrInflight[id]=nil
    end })
    terrWorker()
end

-- track which crew slots are already stationed somewhere (avoid re-stationing)
local terrStationInflight = {}   -- crew slot idx -> true while a station call is pending

-- station selected & free crew onto districts we HOLD that aren't full
local function terrGarrisonPass(districts)
    if not OPT.terrGarrison then return end
    local data = getData()
    local crew = (data and data.crew) or {}
    local now  = os.time()

    -- who is eligible: user-picked, exists, not busy, not injured, not already pending
    local pool = {}
    for i=1,crewMaxKey(crew) do
        local m = crew[i]
        if m and OPT.terrPicked[i] and m.rarity~=nil
           and m.duty==nil and (m.injuredUntil or 0)<=now
           and not terrStationInflight[i] then
            table.insert(pool, i)
        end
    end
    if #pool==0 then return end
    -- station strongest picked first
    table.sort(pool, function(a,b)
        local ma,mb = crew[a],crew[b]
        return ((ma.atk or 0)+(ma.def or 0)) > ((mb.atk or 0)+(mb.def or 0))
    end)

    local pi = 1
    for _, d in ipairs(districts) do
        if pi > #pool then break end
        if d.mine then
            local cap  = d.garrisonCap or 0
            local have = d.garrisonCount or 0
            local want = OPT.terrGarrisonFill and cap or math.min(OPT.terrGarrisonNum, cap)
            local free = want - have
            while free > 0 and pi <= #pool do
                local slot = pool[pi]; pi = pi + 1
                if not terrStationInflight[slot] then
                    terrStationInflight[slot] = true
                    local did = d.id
                    local dname = d.name or ("district "..did)
                    -- queue the station call (paced) instead of firing them all at once
                    terrEnqueue({ action="station", a=did, b=slot, done=function(success,res)
                        if success then
                            updatePanel(("stationed %s -> %s"):format(
                                (crew[slot] and crew[slot].name) or ("slot "..slot), dname))
                        end
                        -- clear after a moment so a failed placement can retry next pass
                        task.delay(2, function() terrStationInflight[slot]=nil end)
                    end })
                    free = free - 1
                end
            end
        end
    end
    if #terrQueue > 0 then terrWorker() end
end

local function terrLoop()
    if terrRunning then return end
    terrRunning = true
    while not _G.CrewAutoRoll_Stop and OPT.terrEnabled do
        local ok, err = pcall(function()
            local districts = terrFetchMap()
            if not districts then return end
            local now = os.time()

            -- how much stamina an attack costs, and how much I have right now
            local attackCost = (Config and Config.TERRITORY and Config.TERRITORY.staminaCost) or 1
            local myData = getData()
            local myStamina = (myData and myData.pools and myData.pools.stamina) or 0
            -- would attacking drop me below my reserve, or does one attack cost more than allowed?
            local canAffordAttack = (attackCost <= OPT.terrMaxAttackCost)
                                    and ((myStamina - attackCost) >= OPT.terrMinStamina)

            -- gather actionable targets
            local claimables, attackables = {}, {}
            for _, d in ipairs(districts) do
                if not d.mine then
                    local shielded = (d.shieldUntil or 0) > (d.serverNow or now)
                    if OPT.terrClaim and d.holderId==nil and not terrInflight[d.id] then
                        table.insert(claimables, d)
                    elseif OPT.terrAttack and canAffordAttack and d.holderId~=nil and not shielded and not terrInflight[d.id]
                           and (d.garrisonCount or 0) < OPT.terrMaxDefenders
                           and ((not OPT.terrUseWhitelist) or OPT.terrWhitelist[d.name]) then
                        -- only siege lightly-defended districts (fewer than the threshold),
                        -- when the attack cost is within max AND leaves my stamina reserve,
                        -- and (when whitelist is on) only ones you've whitelisted by name
                        table.insert(attackables, d)
                    end
                end
            end

            -- CLAIM: queue all unclaimed (best first). Claims are URGENT so they
            -- jump the queue ahead of attacks/stationing and land as fast as pacing allows.
            table.sort(claimables, function(a,b) return terrClaimScore(a)>terrClaimScore(b) end)
            for _, d in ipairs(claimables) do terrFireClaim(d.id) end

            -- ATTACK: focus the best target (attack costs stamina; don't spray)
            if #attackables>0 then
                table.sort(attackables, function(a,b) return terrAttackScore(a)>terrAttackScore(b) end)
                terrFireAttack(attackables[1].id)
            end

            -- GARRISON: station selected free crew onto districts we hold
            terrGarrisonPass(districts)
        end)
        if not ok then log("territory errored:", err) end
        task.wait(OPT.terrPoll)
    end
    terrRunning = false
end

----------------------------------------------------------------
-- MAIN LOOP
----------------------------------------------------------------
local running=false
local function mainLoop()
    if running then return end
    running=true
    -- run one module pass safely: a crash in ONE module can't kill the loop
    local function safe(label, fn, ...)
        local ok, err = pcall(fn, ...)
        if not ok then
            log("module '"..label.."' errored:", err)
            updatePanel(label.." error (skipped)")
        end
        return ok
    end
    while not _G.CrewAutoRoll_Stop do
        local data=getData()
        local native=hasNativeAutoRoll()
        local crewDone=false

        if data then
            modeLbl.Text = native and "Mode: NATIVE + jobs/bank/etc (any tab)" or "Mode: manual (any tab)"
            if OPT.crewEnabled then
                local ok, res = pcall(function()
                    return native and crewPassNative(data) or (not native and crewPassManual(data))
                end)
                if ok then crewDone = res else log("crew errored:", res); updatePanel("crew error (skipped)") end
            end
            if OPT.jobsEnabled      and not _G.CrewAutoRoll_Stop then safe("jobs", jobsPassLive, getData() or data) end
            if OPT.bankEnabled      and not _G.CrewAutoRoll_Stop then safe("bank", bankPass, getData() or data) end
            if OPT.contractsEnabled and not _G.CrewAutoRoll_Stop then safe("contracts", contractsPass, getData() or data) end
            if OPT.playtimeEnabled  and not _G.CrewAutoRoll_Stop then safe("playtime", playtimePass, getData() or data) end
            if OPT.opsEnabled       and not _G.CrewAutoRoll_Stop then safe("ops", opsPass, getData() or data) end
            if OPT.famEnabled       and not _G.CrewAutoRoll_Stop then safe("family perks", famPass) end
            if OPT.bossEnabled      and not _G.CrewAutoRoll_Stop then safe("bosses", bossPass) end
            if OPT.atkEnabled       and not _G.CrewAutoRoll_Stop then safe("attack", pvpPass) end
        else
            -- No data yet: the server pushes it over "Sync" periodically. It
            -- usually arrives within a few seconds of joining / of any action.
            -- We just wait; do NOT fall back to UI reading (crew needs data).
            updatePanel("waiting for game data (Sync)...")
            modeLbl.Text="Mode: waiting for data (Sync)..."
        end

        local continuous = OPT.jobsEnabled or OPT.bankEnabled or OPT.contractsEnabled or OPT.playtimeEnabled or OPT.opsEnabled or OPT.terrEnabled or OPT.famEnabled or OPT.bossEnabled or OPT.atkEnabled
        if OPT.crewEnabled and crewDone and not continuous then
            updatePanel("DONE - all crew targets!"); _G.CrewAutoRoll_Stop=true; break
        end

        -- start the fast territory loop on demand if toggled on mid-run
        if OPT.terrEnabled and not terrRunning and not _G.CrewAutoRoll_Stop then
            task.spawn(terrLoop)
        end

        if not _G.CrewAutoRoll_Stop then
            updatePanel(stats.rolling>0 and ("server rolling "..stats.rolling.." slot(s)...") or "running")
        end
        if _G.CrewAutoRoll_Stop then break end
        task.wait(OPT.loopDelay)
    end
    running=false
    updatePanel("stopped")
    btn.Text="START"; btn.BackgroundColor3=ONCOL
end

btn.Activated:Connect(function()
    if _G.CrewAutoRoll_Stop then
        if not (OPT.crewEnabled or OPT.jobsEnabled or OPT.bankEnabled or OPT.contractsEnabled or OPT.playtimeEnabled or OPT.opsEnabled or OPT.terrEnabled or OPT.famEnabled or OPT.bossEnabled or OPT.atkEnabled) then
            updatePanel("enable a module first"); return
        end
        _G.CrewAutoRoll_Stop=false
        btn.Text="STOP"; btn.BackgroundColor3=Color3.fromRGB(190,70,70)
        if OPT.autoSaveConfig then pcall(SaveConfiguration) end
        task.spawn(mainLoop)
        if OPT.terrEnabled then task.spawn(terrLoop) end
    else
        _G.CrewAutoRoll_Stop=true
        btn.Text="START"; btn.BackgroundColor3=ONCOL
        updatePanel("stopping...")
        if OPT.autoSaveConfig then pcall(SaveConfiguration) end
    end
end)
closeBtn.Activated:Connect(function() _G.CrewAutoRoll_Stop=true; task.wait(0.1); gui:Destroy() end)

