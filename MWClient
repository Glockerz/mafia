local function buildKeepSet()
    local keep={}; local minIdx=nameToIndex(OPT.crewTargetName) or 6
    local names=rarityList()
    for i=minIdx,#names do keep[i]=true end
    return keep,minIdx
end
-- true when slot i is allowed to be rolled given the optional slot-range limit.
-- When crewUseRange is on, ONLY slots within [crewSlotMin, crewSlotMax] are
-- touched, so you can keep e.g. slots 1-9 as standing defense/attack and only
-- reroll slots 10-15.
local function crewSlotInScope(i)
    if not OPT.crewUseRange then return true end
    local lo=math.min(OPT.crewSlotMin, OPT.crewSlotMax)
    local hi=math.max(OPT.crewSlotMin, OPT.crewSlotMax)
    return i>=lo and i<=hi
end
-- Highest slot index we must iterate to. IMPORTANT: #crew is unreliable when a
-- slot in the middle is empty (moving/reorganizing crew leaves crew[k]=nil, and
-- Lua's # stops at the first hole), which would skip trailing empty slots. So we
-- scan for the real max key AND, in range mode, always extend to crewSlotMax so
-- empty slots inside your range (e.g. 14-15 after you moved them) still get rolled.
local function crewMaxSlot(crew)
    local n=crewMaxKey(crew)
    if OPT.crewUseRange then
        n=math.max(n, OPT.crewSlotMin, OPT.crewSlotMax)
    end
    return n
end
local function crewPassNative(data)
    local crew=data.crew or {}; local keep,targetIdx=buildKeepSet()
    stats.kept,stats.rolling,stats.remaining=0,0,0
    local now=os.time(); local CA=getRemote("CrewAction")
    for i=1,crewMaxSlot(crew) do
        if _G.CrewAutoRoll_Stop then break end
        if not (OPT.protectLeader and i==1) and crewSlotInScope(i) then
            local m=crew[i] or {}; local busy=(m.duty~=nil) or ((m.injuredUntil or 0)>now)
            if m.rolling then stats.rolling=stats.rolling+1
            elseif m.rarity~=nil and keep[m.rarity] then stats.kept=stats.kept+1
            elseif busy then
            else
                stats.remaining=stats.remaining+1
                throttled(CA,"autoroll",i,OPT.crewTier,targetIdx)
                updatePanel(("auto-rolling slot %d -> %s+"):format(i,indexToName(targetIdx)))
                if not OPT.crewScopeAll then break end
            end
        end
    end
    return stats.rolling==0 and stats.remaining==0 and stats.kept>0
end
local function crewPassManual(data)
    local crew=data.crew or {}; local keep=buildKeepSet()
    stats.kept,stats.rolling,stats.remaining=0,0,0
    local now=os.time(); local CA=getRemote("CrewAction")
    for i=1,crewMaxSlot(crew) do
        if _G.CrewAutoRoll_Stop then break end
        if not (OPT.protectLeader and i==1) and crewSlotInScope(i) then
            local m=crew[i] or {}; local busy=(m.duty~=nil) or ((m.injuredUntil or 0)>now)
            if m.rolling then stats.rolling=stats.rolling+1
            elseif m.rarity~=nil and keep[m.rarity] then stats.kept=stats.kept+1
            elseif busy then
            elseif m.rarity~=nil then
                stats.remaining=stats.remaining+1
                if throttled(CA,"dismiss",i) then stats.dismissed=stats.dismissed+1 end
                updatePanel("dismissing slot "..i)
            else
                stats.remaining=stats.remaining+1
                if throttled(CA,"hire",OPT.crewTier) then stats.hired=stats.hired+1 end
                updatePanel("hiring slot "..i)
            end
        end
    end
    return stats.remaining==0 and stats.rolling==0
end

