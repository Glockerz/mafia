local function contractsPass(data)
    local c=data.contracts; if type(c)~="table" then return end
    local CA=getRemote("ContractAction")
    local dailyCount=configCount("DAILY_TIERS",3)
    local weeklyCount=configCount("WEEKLY_TIERS",1)

    local daily=type(c.daily)=="table" and c.daily or {}
    local claimedDaily=0
    for i=1,math.max(#daily,dailyCount) do
        if _G.CrewAutoRoll_Stop then break end
        local t=daily[i]
        if t then
            if t.done and not t.claimed then
                if throttled(CA,"claim",i) then stats.contracts=stats.contracts+1; updatePanel("claimed daily "..i) end
            end
            if t.claimed then claimedDaily=claimedDaily+1 end
        end
    end

    local weekly=type(c.weekly)=="table" and c.weekly or {}
    if weekly.id~=nil then weekly={weekly} end
    local claimedWeekly=0
    for j=1,math.max(#weekly,weeklyCount) do
        if _G.CrewAutoRoll_Stop then break end
        local w=weekly[j]
        if w then
            if w.done and not w.claimed then
                if throttled(CA,"claimweekly",j) then stats.contracts=stats.contracts+1; updatePanel("claimed weekly "..j) end
            end
            if w.claimed then claimedWeekly=claimedWeekly+1 end
        end
    end

    -- daily bonus: all daily claimed
    if not _G.CrewAutoRoll_Stop and dailyCount>0 and claimedDaily>=dailyCount and not c.bonusClaimed then
        if throttled(CA,"claimbonus") then stats.contracts=stats.contracts+1; updatePanel("claimed daily bonus") end
    end
    -- weekly bonus: all weekly claimed
    if not _G.CrewAutoRoll_Stop and weeklyCount>0 and claimedWeekly>=weeklyCount and not c.weeklyBonusClaimed then
        if throttled(CA,"claimweeklybonus") then stats.contracts=stats.contracts+1; updatePanel("claimed weekly bonus") end
    end
end

