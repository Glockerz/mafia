--[[
==================================================================
  MAFIA WARS  -  AUTO SUITE                              + glass panel
  Crew roll · Jobs · Auto-Bank · Auto-Contracts · Auto-Playtime
==================================================================
  Matched against the real client (Glockerz/mafia):
    MWClient / CrewTab / JobsTab / BankTab / ContractsTab / SafehouseTab

  REMOTES USED (all read/fire live data -> tab-independent via getgc):
    Crew      : Remotes.CrewAction("autoroll"|"dismiss"|"hire", ...)
    Jobs      : Remotes.DoJob(jobId)
    Bank      : Remotes.Deposit(amount)          -- fee is server-side, can't be removed
    Contracts : Remotes.ContractAction("claim"|"claimweekly"|"claimbonus"|"claimweeklybonus", i)
    Playtime  : Remotes.ClaimLadder(rungIndex)

  NOTE ON THE BANK FEE: the deposit fee is applied on the SERVER; the
  client only sends the amount. It cannot be bypassed. Auto-Bank just
  minimizes how long cash sits stealable. (The only zero-fee path is the
  in-game "No Bank Fees" pass -> data.derived.noBankFees.)

  Stop from console:  _G.CrewAutoRoll_Stop = true

  AUTO-INJECT / LOAD GUARD:
    * Refuses to run twice in the same client (kills the old GUI + loops
      first, so re-running just refreshes instead of stacking).
    * Waits for the game to finish loading before touching remotes.
    * Re-injects itself automatically after a teleport / server hop using
      the executor's queue_on_teleport, so grinding survives rejoins.
      Set _G.AutoSuite_NoRequeue = true before running to disable that.
==================================================================
]]

----------------------------------------------------------------
-- LOAD GUARD + AUTO-INJECT (survive re-runs and teleports)
----------------------------------------------------------------
-- 1) wait until the game is actually loaded before we do anything
if not game:IsLoaded() then game.Loaded:Wait() end

-- 2) single-instance guard. If a previous copy is running, ask it to stop
--    and tear down its GUI so this fresh run cleanly replaces it, instead
--    of erroring out or stacking two GUIs / two loops on top of each other.
do
    local genv = (getgenv and getgenv()) or _G
    if genv.AutoSuite_LOADED then
        _G.CrewAutoRoll_Stop = true                 -- signal old loops to end
        pcall(function()
            local pg = game:GetService("Players").LocalPlayer:FindFirstChild("PlayerGui")
            local gui = pg and pg:FindFirstChild("AutoSuiteGUI")
            if gui then gui:Destroy() end
        end)
        task.wait(0.2)                               -- let old loops notice the stop flag
    end
    genv.AutoSuite_LOADED = true
end

-- 3) auto re-inject after teleport / server hop. Executors expose one of
--    queue_on_teleport / queueonteleport / syn.queue_on_teleport. We queue
--    whatever bootstrap the user launched with:
--      _G.AutoSuite_SelfURL  -> set this before running when you load via
--                               loadstring(game:HttpGet(url)); it re-fetches.
--    otherwise, if the script was saved to disk we re-run that file;
--    otherwise re-injection is skipped (nothing safe to re-run).
do
    -- default source URL for re-injection (override by setting
    -- _G.AutoSuite_SelfURL before running if you host it elsewhere)
    if type(_G.AutoSuite_SelfURL) ~= "string" or _G.AutoSuite_SelfURL == "" then
        _G.AutoSuite_SelfURL = "https://raw.githubusercontent.com/Glockerz/mafia/refs/heads/main/MWClient"
    end
    if not _G.AutoSuite_NoRequeue then
        local queue = queue_on_teleport
            or (syn and syn.queue_on_teleport)
            or queueonteleport
        if type(queue) == "function" then
            local boot
            if type(_G.AutoSuite_SelfURL) == "string" and _G.AutoSuite_SelfURL ~= "" then
                boot = ('loadstring(game:HttpGet(%q))()'):format(_G.AutoSuite_SelfURL)
            elseif readfile and isfile and isfile("MafiaWarsAutoSuite.lua") then
                boot = 'loadstring(readfile("MafiaWarsAutoSuite.lua"))()'
            end
            if boot then pcall(queue, boot) end
        end
    end
end

