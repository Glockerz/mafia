local wlRows={}   -- district name -> {frame,paint}
local function refreshDistrictList()
    local TA=getRemote("TerritoryAction")
    if not TA then return end
    local ok,res=pcall(function() return TA:InvokeServer("map") end)
    if not (ok and type(res)=="table" and type(res.districts)=="table") then return end
    -- gather unique attackable (not-mine) districts by name
    local seen={}
    local order=0
    for _,d in ipairs(res.districts) do
        local nm=d.name
        if nm and not seen[nm] then
            seen[nm]=true; order=order+1
            local row=wlRows[nm]
            if not row then
                local rf=Instance.new("Frame"); rf.BackgroundColor3=Color3.fromRGB(255,255,255)
                rf.BackgroundTransparency=0.95; rf.BorderSizePixel=0; rf.Size=UDim2.new(1,0,0,26)
                rf.LayoutOrder=order; rf.ZIndex=5; rf.Parent=wlFrame
                Instance.new("UICorner",rf).CornerRadius=UDim.new(0,6)
                local chk=Instance.new("TextButton"); chk.AnchorPoint=Vector2.new(0,0.5)
                chk.Position=UDim2.new(0,6,0.5,0); chk.Size=UDim2.fromOffset(20,20)
                chk.Font=Enum.Font.GothamBold; chk.TextSize=13; chk.TextColor3=Color3.fromRGB(255,255,255)
                chk.ZIndex=6; chk.Parent=rf; Instance.new("UICorner",chk).CornerRadius=UDim.new(0,5)
                local lbl=mklabel(rf,"",UDim2.new(0,32,0,0),UDim2.new(1,-38,1,0),11,TXT,false,nil,6)
                local nmKey=nm
                local function paint() local on=OPT.terrWhitelist[nmKey]
                    chk.Text=on and "X" or ""; chk.BackgroundColor3=on and ONCOL or OFFCOL end
                chk.Activated:Connect(function() OPT.terrWhitelist[nmKey]=(not OPT.terrWhitelist[nmKey]) or nil; paint() end)
                row={frame=rf,lbl=lbl,paint=paint}; wlRows[nm]=row; paint()
                table.insert(guiRefreshers, paint)
            end
            local who = d.mine and "(yours)" or (d.holderName and ("held by "..d.holderName) or "unclaimed")
            local city = d.city and (" - "..d.city) or ""
            row.lbl.Text=("%s%s  T%s  %s"):format(nm, city, tostring(d.tier or "?"), who)
            row.frame.Visible=true
            row.paint()
        end
    end
end
